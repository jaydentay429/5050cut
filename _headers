/*
  Cache-Control: public, max-age=300
/src/*
  Cache-Control: public, max-age=60, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000
/vendor/*
  Cache-Control: public, max-age=31536000
/favicon.svg
  Cache-Control: public, max-age=86400
/ads.txt
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
